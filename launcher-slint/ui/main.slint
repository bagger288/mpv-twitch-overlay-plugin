import { ScrollView, ComboBox, Palette } from "std-widgets.slint";

export struct RecordingItem {
    id: string,
    date_str: string,
    parts_count: int,
    duration_str: string,
    size_str: string,
    has_chat: bool,
    has_emotes: bool,
}

export struct ChannelItem {
    name: string,
    count: int,
}

component AppButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <length> custom_height: 32px;
    callback clicked <=> touch.clicked;

    height: root.custom_height;
    border-radius: 6px;
    border-width: 1px;
    border-color: !root.enabled ? #252834 : root.primary ? (touch.has-hover ? #b785ff : #a970ff) : root.danger ? (touch.has-hover ? #d32f2f : #c62828) : (touch.has-hover ? #3f4354 : #2c303e);
    background: !root.enabled ? #181a22 : root.primary ? (touch.has-hover ? #772ce8 : #9146ff) : root.danger ? (touch.has-hover ? #b71c1c : #9F2305) : (touch.has-hover ? #252834 : #1c1f28);
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
    }

    Text {
        text: root.text;
        color: !root.enabled ? #555869 : #ffffff;
        font-size: 9pt;
        font-weight: root.primary ? 700 : 600;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component AppInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text: "";
    in property <InputType> input-type: InputType.text;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    out property <bool> has-focus: input.has-focus;
    property <bool> show-password: false;

    forward-focus: input;
    height: 34px;
    background: input.has-focus ? #1a1c25 : #14161f;
    border-radius: 6px;
    border-width: 1px;
    border-color: input.has-focus ? #9146ff : #272a38;
    animate border-color { duration: 150ms; }
    animate background { duration: 150ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;

        input := TextInput {
            single-line: true;
            vertical-alignment: center;
            font-size: 9.5pt;
            color: #efeff1;
            selection-background-color: #9146ff;
            selection-foreground-color: #ffffff;
            input-type: (root.input-type == InputType.password && !root.show-password) ? InputType.password : InputType.text;
            enabled: root.enabled;
            read-only: root.read-only;
        }

        if root.input-type == InputType.password && root.text != "": TouchArea {
            width: 26px;
            mouse-cursor: pointer;
            clicked => { root.show-password = !root.show-password; }
            Text {
                text: root.show-password ? "👁" : "🔒";
                font-size: 10pt;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }

    if root.text == "" && !input.has-focus: Text {
        x: 10px;
        y: (parent.height - self.height) / 2;
        text: root.placeholder-text;
        font-size: 9pt;
        color: #5d6174;
    }
}

component StatCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> icon;
    in property <color> value_color: #ffffff;

    background: #151822;
    border-radius: 6px;
    border-width: 1px;
    border-color: #262938;
    height: 52px;

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 2px;
        alignment: center;

        HorizontalLayout {
            spacing: 5px;
            Text {
                text: root.icon;
                font-size: 8pt;
                vertical-alignment: center;
            }
            Text {
                text: root.label;
                font-size: 7.5pt;
                font-weight: 700;
                color: #838799;
                vertical-alignment: center;
            }
            Rectangle { }
        }

        Text {
            text: root.value;
            font-size: 11pt;
            font-weight: 700;
            color: root.value_color;
            vertical-alignment: center;
        }
    }
}

component DialogButton inherits Rectangle {
    in property <string> text;
    in property <color> bg_color: #2d2d35;
    in property <color> hover_color: #3b3b44;
    in property <color> text_color: #ffffff;
    callback clicked <=> touch.clicked;

    height: 32px;
    background: touch.has-hover ? root.hover_color : root.bg_color;
    border-radius: 4px;
    animate background { duration: 150ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    Text {
        text: root.text;
        color: root.text_color;
        font-size: 9pt;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

export component MainWindow inherits Window {
    title: "Twitch recorder";
    icon: @image-url("assets/app.png");
    min-width: 560px;
    min-height: 640px;
    preferred-width: 680px;
    preferred-height: 780px;
    background: #0d0e13;

    // Palette tokens
    out property <color> c_bg: #0d0e13;
    out property <color> c_card: #14161f;
    out property <color> c_card_border: #222532;
    out property <color> c_input: #1a1c26;
    out property <color> c_accent: #9146ff;
    out property <color> c_accent_hover: #772ce8;
    out property <color> c_text: #f0f0f4;
    out property <color> c_text_dim: #8b8f9f;
    out property <color> c_title: #c499ff;
    out property <color> c_btn_bg: #222530;
    out property <color> c_btn_hover: #2e3240;

    // State properties
    in-out property <int> active_tab: 0;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // Callbacks
    // Close confirmation dialog
    in-out property <bool> show_close_dialog: false;
    callback confirm_quit();
    callback confirm_minimize_to_tray();
    callback cancel_close();

    callback select_tab(int);
    callback refresh_records();
    callback open_records_folder();
    callback open_session_folder();
    callback launch_mpv();
    callback select_channel(string);
    callback select_recording(string);

    callback run_import();
    callback browse_import_video();

    callback toggle_recording();
    callback toggle_pc_agent();
    callback clear_pc_agent_console();

    callback refresh_token_manually();
    callback save_settings();
    callback check_tool_paths();

    // Data models
    in property <[ChannelItem]> channels: [];
    in-out property <string> selected_channel: "";
    in property <[RecordingItem]> recordings: [];
    in-out property <string> selected_recording_id: "";

    // Tab 2 Import properties
    in-out property <string> imp_channel: "";
    in-out property <string> imp_video: "";
    in-out property <string> imp_time: "";
    in-out property <bool> imp_auto_detect: true;
    in-out property <string> imp_dates: "";
    in property <string> imp_console_text: "";
    in property <bool> imp_busy: false;

    // Tab 3 Live Recorder properties
    in-out property <string> rec_channel: "";
    in-out property <string> rec_quality: "best";
    in property <bool> rec_active: false;
    in property <string> rec_status_text: "Готов к записи";
    in property <string> rec_console_text: "";
    in property <string> rec_duration_text: "00:00:00";
    in property <string> rec_size_text: "0 MB";
    in property <string> rec_messages_text: "0 сообщ.";

    // Tab 4 PC Agent properties
    in property <bool> agent_active: false;
    in property <string> agent_status_text: "Листенер остановлен";
    in property <string> agent_console_text: "";
    in property <bool> agent_recording_now: false;
    in property <string> agent_duration_text: "00:00:00";
    in property <string> agent_size_text: "0 MB";
    in property <string> agent_messages_text: "0 сообщ.";

    // Tab 5 Settings properties
    in-out property <string> cfg_streamlink: "streamlink";
    in-out property <string> cfg_mpv: "mpv";
    in-out property <string> cfg_client_id: "";
    in-out property <string> cfg_app_token: "";
    in-out property <string> cfg_client_secret: "";
    in-out property <string> cfg_refresh_token: "";
    in property <string> cfg_token_status: "Токен обновляется при запуске";
    in-out property <string> cfg_records_dir: "records";
    in-out property <string> cfg_server_url: "";
    in-out property <string> cfg_proxy_playlist: "";
    in-out property <string> cfg_engine: "Auto";
    in property <string> status_streamlink: "";
    in property <bool> valid_streamlink: false;
    in property <string> status_mpv: "";
    in property <bool> valid_mpv: false;
    in property <string> status_ffmpeg: "";
    in property <bool> valid_ffmpeg: false;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        // Modern Header
        HorizontalLayout {
            height: 38px;
            spacing: 10px;

            Image {
                source: @image-url("assets/app.png");
                width: 34px;
                height: 34px;
            }

            VerticalLayout {
                spacing: 1px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Twitch Recorder";
                        font-size: 13pt;
                        font-weight: 800;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        height: 18px;
                        background: #9146ff26;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #9146ff66;
                        y: 2px;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: "RUST ENGINE";
                                font-size: 7pt;
                                font-weight: 800;
                                color: #c499ff;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Text {
                    text: "Запись прямых трансляций, чата и интерактивный просмотр";
                    font-size: 8.5pt;
                    color: root.c_text_dim;
                }
            }

            Rectangle { } // Spacer

            // Live status badge in header
            Rectangle {
                height: 26px;
                background: root.rec_active ? #ff174418 : (root.agent_active ? #00e67614 : #171922);
                border-radius: 13px;
                border-width: 1px;
                border-color: root.rec_active ? #ff174488 : (root.agent_active ? #00e67655 : #252836);
                y: 6px;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;

                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: root.rec_active ? #ff1744 : (root.agent_active ? #00e676 : #6c7082);
                        y: 9.5px;
                    }

                    Text {
                        text: root.rec_active ? "ЗАПИСЬ" : (root.agent_active ? "АГЕНТ ВКЛ" : "ОЖИДАНИЕ");
                        font-size: 7.5pt;
                        font-weight: 800;
                        color: root.rec_active ? #ff5252 : (root.agent_active ? #00e676 : #7f8396);
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Modern Segmented Tab Bar
        Rectangle {
            height: 38px;
            background: #11131b;
            border-radius: 8px;
            border-width: 1px;
            border-color: #1f222e;

            HorizontalLayout {
                padding: 3px;
                spacing: 3px;

                for tab_item[i] in [
                    { title: "Записи", icon: "📁" },
                    { title: "Импорт", icon: "📥" },
                    { title: "Запись", icon: "🔴" },
                    { title: "PC Agent", icon: "🤖" },
                    { title: "Настройки", icon: "⚙️" },
                ]: Rectangle {
                    background: root.active_tab == i ? #9146ff : (tab_touch.has-hover ? #1c1f2b : #00000000);
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: root.active_tab == i ? #b17eff : #00000000;
                    animate background { duration: 120ms; }

                    tab_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.active_tab = i;
                            root.select_tab(i);
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;

                        Text {
                            text: tab_item.icon;
                            font-size: 9pt;
                            vertical-alignment: center;
                        }

                        Text {
                            text: tab_item.title;
                            color: root.active_tab == i ? #ffffff : (tab_touch.has-hover ? #f0f0f4 : #8b8f9f);
                            font-size: 9pt;
                            font-weight: root.active_tab == i ? 700 : 500;
                            vertical-alignment: center;
                        }

                        if i == 2 && root.rec_active: Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: #ff1744;
                            y: 13px;
                        }
                        if i == 3 && root.agent_active: Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: #00e676;
                            y: 13px;
                        }
                    }
                }
            }
        }

        // Tab Content Area
        Rectangle {
            background: root.c_card;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.c_card_border;

            // Tab 1: Records
            if root.active_tab == 0: VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 10px;

                    // Left channel column
                    VerticalLayout {
                        width: 160px;
                        spacing: 6px;

                        HorizontalLayout {
                            Text {
                                text: "КАНАЛЫ";
                                font-size: 8pt;
                                font-weight: 800;
                                color: #767a8c;
                                vertical-alignment: center;
                            }
                            Rectangle { }
                        }

                        ScrollView {
                            VerticalLayout {
                                spacing: 3px;
                                for ch in root.channels: Rectangle {
                                    height: 32px;
                                    background: root.selected_channel == ch.name ? #9146ff : (ch_touch.has-hover ? #1f2230 : #171924);
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: root.selected_channel == ch.name ? #b17eff : (ch_touch.has-hover ? #303546 : #232635);
                                    animate background { duration: 120ms; }

                                    ch_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.selected_channel = ch.name;
                                            root.select_channel(ch.name);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;

                                        Text {
                                            text: ch.name;
                                            color: #ffffff;
                                            font-size: 9pt;
                                            font-weight: root.selected_channel == ch.name ? 700 : 500;
                                            vertical-alignment: center;
                                        }

                                        Rectangle { }

                                        Rectangle {
                                            height: 18px;
                                            background: root.selected_channel == ch.name ? #ffffff33 : #242736;
                                            border-radius: 9px;
                                            y: 7px;

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                Text {
                                                    text: ch.count;
                                                    color: root.selected_channel == ch.name ? #ffffff : #8a8e9f;
                                                    font-size: 7.5pt;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Right table view
                    VerticalLayout {
                        spacing: 6px;

                        // Toolbar
                        HorizontalLayout {
                            height: 30px;
                            spacing: 6px;

                            Text {
                                text: root.selected_channel != "" ? "Записи: " + root.selected_channel : "Выберите канал";
                                font-size: 10pt;
                                font-weight: 700;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                            Rectangle { } // Spacer
                            AppButton {
                                text: "Папка";
                                clicked => { root.open_records_folder(); }
                            }
                            AppButton {
                                text: "Обновить";
                                clicked => { root.refresh_records(); }
                            }
                        }

                        // Table Header
                        Rectangle {
                            height: 28px;
                            background: #191c26;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #262938;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                Text { width: 145px; text: "Дата и время"; font-size: 8pt; font-weight: 700; color: #838799; vertical-alignment: center; }
                                Text { width: 48px; text: "Части"; font-size: 8pt; font-weight: 700; color: #838799; vertical-alignment: center; }
                                Text { width: 75px; text: "Время"; font-size: 8pt; font-weight: 700; color: #838799; vertical-alignment: center; }
                                Text { width: 75px; text: "Размер"; font-size: 8pt; font-weight: 700; color: #838799; vertical-alignment: center; }
                                Text { width: 48px; text: "Чат"; font-size: 8pt; font-weight: 700; color: #838799; horizontal-alignment: center; vertical-alignment: center; }
                                Text { width: 55px; text: "Эмоуты"; font-size: 8pt; font-weight: 700; color: #838799; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }

                        // Recordings List
                        ScrollView {
                            VerticalLayout {
                                spacing: 3px;
                                for rec in root.recordings: Rectangle {
                                    height: 34px;
                                    background: root.selected_recording_id == rec.id ? #241c38 : (rec_touch.has-hover ? #1c1e28 : #151722);
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: root.selected_recording_id == rec.id ? #9146ff : (rec_touch.has-hover ? #2e3242 : #222532);
                                    animate background { duration: 100ms; }

                                    rec_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.selected_recording_id = rec.id;
                                            root.select_recording(rec.id);
                                        }
                                        double-clicked => {
                                            root.selected_recording_id = rec.id;
                                            root.launch_mpv();
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 6px;
                                        Text { width: 145px; text: rec.date_str; color: #ffffff; font-size: 9pt; font-weight: root.selected_recording_id == rec.id ? 700 : 400; vertical-alignment: center; }
                                        Text { width: 48px; text: rec.parts_count + " ч."; color: #8b8f9f; font-size: 8.5pt; vertical-alignment: center; }
                                        Text { width: 75px; text: rec.duration_str; color: #e2e4ee; font-size: 9pt; vertical-alignment: center; }
                                        Text { width: 75px; text: rec.size_str; color: #8b8f9f; font-size: 8.5pt; vertical-alignment: center; }

                                        // Chat badge
                                        Rectangle {
                                            width: 48px;
                                            height: 20px;
                                            border-radius: 4px;
                                            background: rec.has_chat ? #00e67618 : #1c1e28;
                                            y: 7px;

                                            Text {
                                                text: rec.has_chat ? "✓ ЧАТ" : "—";
                                                color: rec.has_chat ? #00e676 : #484b5c;
                                                font-size: 7pt;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        // Emotes badge
                                        Rectangle {
                                            width: 55px;
                                            height: 20px;
                                            border-radius: 4px;
                                            background: rec.has_emotes ? #bf94ff22 : #1c1e28;
                                            y: 7px;

                                            Text {
                                                text: rec.has_emotes ? "★ ЭМО" : "—";
                                                color: rec.has_emotes ? #c499ff : #484b5c;
                                                font-size: 7pt;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Footer
                HorizontalLayout {
                    height: 38px;
                    spacing: 8px;
                    Text {
                        text: "💡 Двойной клик по строке для запуска воспроизведения";
                        color: #727687;
                        font-size: 8.5pt;
                        vertical-alignment: center;
                    }
                    Rectangle { } // Spacer
                    AppButton {
                        text: "Папка сессии";
                        clicked => { root.open_session_folder(); }
                    }
                    AppButton {
                        text: "▶ Смотреть в mpv";
                        primary: true;
                        custom_height: 36px;
                        clicked => { root.launch_mpv(); }
                    }
                }
            }

            // Tab 2: Import
            if root.active_tab == 1: VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Text { text: "Импорт чата для существующих видеофайлов"; font-size: 11pt; font-weight: 700; color: root.c_title; }

                HorizontalLayout {
                    spacing: 10px;

                    // Source block
                    Rectangle {
                        background: #171924;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #252838;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;

                            Text { text: "Канал Twitch:"; font-size: 8.5pt; font-weight: 600; color: root.c_text_dim; }
                            AppInput { text <=> root.imp_channel; placeholder-text: "Например: shroud"; }

                            Text { text: "Файлы видео (video.ts / mp4 через ';'):"; font-size: 8.5pt; font-weight: 600; color: root.c_text_dim; }
                            HorizontalLayout {
                                spacing: 6px;
                                AppInput { text <=> root.imp_video; placeholder-text: "Пути к файлам video.ts / mp4"; }
                                AppButton { text: "Обзор…"; clicked => { root.browse_import_video(); } }
                            }
                        }
                    }

                    // Sync block
                    Rectangle {
                        background: #171924;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #252838;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;

                            Text { text: "Старт видео (UTC): YYYY-MM-DD HH:MM:SS"; font-size: 8.5pt; font-weight: 600; color: root.c_text_dim; }
                            AppInput { text <=> root.imp_time; placeholder-text: "2026-11-04 12:00:00"; }

                            HorizontalLayout {
                                spacing: 8px;
                                height: 26px;
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    border-width: 1.5px;
                                    border-color: root.imp_auto_detect ? root.c_accent : #3a3e50;
                                    border-radius: 4px;
                                    background: root.imp_auto_detect ? root.c_accent : #1a1c26;
                                    y: 4px;

                                    if root.imp_auto_detect: Text {
                                        text: "✓";
                                        color: #ffffff;
                                        font-size: 9pt;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.imp_auto_detect = !root.imp_auto_detect; }
                                    }
                                }
                                Text {
                                    text: "Автоопределение старта по сообщениям чата";
                                    color: root.c_text;
                                    font-size: 9pt;
                                    vertical-alignment: center;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.imp_auto_detect = !root.imp_auto_detect; }
                                    }
                                }
                                Rectangle { }
                            }

                            Text { text: "Даты архива (UTC): YYYY-MM-DD, …"; font-size: 8.5pt; font-weight: 600; color: root.c_text_dim; }
                            AppInput { text <=> root.imp_dates; placeholder-text: "2026-11-04"; }
                        }
                    }
                }

                HorizontalLayout {
                    AppButton {
                        text: "⚡ Создать сессию из архива";
                        primary: true;
                        custom_height: 36px;
                        enabled: !root.imp_busy;
                        clicked => { root.run_import(); }
                    }
                    Rectangle { }
                }

                // Terminal console
                Rectangle {
                    background: #0d0f15;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #1e212d;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;

                        HorizontalLayout {
                            Text { text: "Терминал импорта"; font-size: 8pt; font-weight: 700; color: #5d6174; }
                            Rectangle { }
                        }

                        ScrollView {
                            Text {
                                text: root.imp_console_text;
                                color: #cfd2e0;
                                font-family: "Consolas";
                                font-size: 8.5pt;
                            }
                        }
                    }
                }
            }

            // Tab 3: Record
            if root.active_tab == 2: VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Text { text: "Прямая запись стрима и чата"; font-size: 11pt; font-weight: 700; color: root.c_title; }

                Rectangle {
                    background: #171924;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #252838;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 12px;

                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "Канал Twitch:"; font-size: 8.5pt; font-weight: 600; color: root.c_text_dim; }
                                AppInput { text <=> root.rec_channel; placeholder-text: "Имя канала для записи"; }
                            }

                            VerticalLayout {
                                width: 140px;
                                spacing: 4px;
                                Text { text: "Качество:"; font-size: 8.5pt; font-weight: 600; color: root.c_text_dim; }
                                ComboBox {
                                    model: ["best", "1080p60", "720p60", "480p", "worst"];
                                    current-value <=> root.rec_quality;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            AppButton {
                                text: root.rec_active ? "⏹ Остановить запись" : "🔴 Начать запись стрима";
                                primary: !root.rec_active;
                                danger: root.rec_active;
                                custom_height: 36px;
                                clicked => { root.toggle_recording(); }
                            }
                            Text {
                                text: root.rec_status_text;
                                color: root.rec_active ? #00e676 : root.c_text_dim;
                                font-size: 9pt;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Rectangle { }
                        }
                    }
                }

                // Modern 3-Stat Metrics Cards
                if root.rec_active: HorizontalLayout {
                    spacing: 8px;
                    StatCard {
                        label: "ДЛИТЕЛЬНОСТЬ";
                        value: root.rec_duration_text;
                        icon: "⏱";
                        value_color: #ffffff;
                    }
                    StatCard {
                        label: "РАЗМЕР ФАЙЛА";
                        value: root.rec_size_text;
                        icon: "💾";
                        value_color: #64b5f6;
                    }
                    StatCard {
                        label: "СООБЩЕНИЯ ЧАТА";
                        value: root.rec_messages_text;
                        icon: "💬";
                        value_color: #81c784;
                    }
                }

                // Console
                Rectangle {
                    background: #0d0f15;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #1e212d;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;

                        HorizontalLayout {
                            Text { text: "Лог записи Streamlink / Twitch Chat"; font-size: 8pt; font-weight: 700; color: #5d6174; }
                            Rectangle { }
                        }

                        ScrollView {
                            Text {
                                text: root.rec_console_text;
                                color: #cfd2e0;
                                font-family: "Consolas";
                                font-size: 8.5pt;
                            }
                        }
                    }
                }
            }

            // Tab 4: PC Agent
            if root.active_tab == 3: VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Text { text: "Автоматический PC Agent"; font-size: 11pt; font-weight: 700; color: root.c_title; }

                Rectangle {
                    background: #171924;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #252838;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        Text {
                            text: "Подключается к серверу мониторинга и автоматически запускает запись при начале стрима.";
                            font-size: 8.5pt;
                            color: root.c_text_dim;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            AppButton {
                                text: root.agent_active ? "⏹ Остановить агент" : "▶ Запустить агент";
                                primary: !root.agent_active;
                                danger: root.agent_active;
                                custom_height: 36px;
                                clicked => { root.toggle_pc_agent(); }
                            }
                            AppButton {
                                text: "Очистить лог";
                                clicked => { root.clear_pc_agent_console(); }
                            }
                            Rectangle { }

                            Rectangle {
                                height: 26px;
                                background: root.agent_active ? #00e67618 : #202330;
                                border-radius: 13px;
                                border-width: 1px;
                                border-color: root.agent_active ? #00e67666 : #2d3040;
                                y: 5px;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;

                                    Rectangle {
                                        width: 7px;
                                        height: 7px;
                                        border-radius: 3.5px;
                                        background: root.agent_active ? #00e676 : #6c7082;
                                        y: 9.5px;
                                    }

                                    Text {
                                        text: root.agent_status_text;
                                        font-size: 8pt;
                                        font-weight: 700;
                                        color: root.agent_active ? #00e676 : #8a8e9f;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // 3-Stat Metrics Cards when agent is recording
                if root.agent_recording_now: HorizontalLayout {
                    spacing: 8px;
                    StatCard {
                        label: "ДЛИТЕЛЬНОСТЬ";
                        value: root.agent_duration_text;
                        icon: "⏱";
                        value_color: #ffffff;
                    }
                    StatCard {
                        label: "РАЗМЕР ФАЙЛА";
                        value: root.agent_size_text;
                        icon: "💾";
                        value_color: #64b5f6;
                    }
                    StatCard {
                        label: "СООБЩЕНИЯ ЧАТА";
                        value: root.agent_messages_text;
                        icon: "💬";
                        value_color: #81c784;
                    }
                }

                // Console
                Rectangle {
                    background: #0d0f15;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #1e212d;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;

                        HorizontalLayout {
                            Text { text: "Лог событий агента"; font-size: 8pt; font-weight: 700; color: #5d6174; }
                            Rectangle { }
                        }

                        ScrollView {
                            Text {
                                text: root.agent_console_text;
                                color: #cfd2e0;
                                font-family: "Consolas";
                                font-size: 8.5pt;
                            }
                        }
                    }
                }
            }

            // Tab 5: Settings
            if root.active_tab == 4: VerticalLayout {
                padding: 12px;
                spacing: 8px;

                ScrollView {
                    VerticalLayout {
                        spacing: 10px;
                        padding-right: 10px;

                        // Section 1: Tools
                        Rectangle {
                            background: #171924;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #252838;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;

                                Text { text: "ВНЕШНИЕ УТИЛИТЫ"; font-size: 8pt; font-weight: 800; color: #767a8c; }

                                Text { text: "Путь к Streamlink:"; font-size: 8.5pt; color: root.c_text_dim; }
                                AppInput { text <=> root.cfg_streamlink; }
                                if root.status_streamlink != "": Text {
                                    text: root.status_streamlink;
                                    color: root.valid_streamlink ? #00e676 : #ff5252;
                                    font-size: 8.5pt;
                                    font-weight: 700;
                                }

                                Text { text: "Путь к mpv:"; font-size: 8.5pt; color: root.c_text_dim; }
                                AppInput { text <=> root.cfg_mpv; }
                                if root.status_mpv != "": Text {
                                    text: root.status_mpv;
                                    color: root.valid_mpv ? #00e676 : #ff5252;
                                    font-size: 8.5pt;
                                    font-weight: 700;
                                }

                                Text { text: "Статус FFmpeg (для экспорта клипов):"; font-size: 8.5pt; color: root.c_text_dim; }
                                if root.status_ffmpeg != "": Text {
                                    text: root.status_ffmpeg;
                                    color: root.valid_ffmpeg ? #00e676 : #ffb300;
                                    font-size: 8.5pt;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    AppButton {
                                        text: "🔍 Проверить утилиты";
                                        clicked => { root.check_tool_paths(); }
                                    }
                                    Rectangle { }
                                }
                            }
                        }

                        // Section 2: Twitch API
                        Rectangle {
                            background: #171924;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #252838;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;

                                Text { text: "TWITCH API И АВТОРИЗАЦИЯ"; font-size: 8pt; font-weight: 800; color: #767a8c; }

                                Text { text: "Twitch Client ID:"; font-size: 8.5pt; color: root.c_text_dim; }
                                AppInput { text <=> root.cfg_client_id; }

                                Text { text: "Twitch App/User Token:"; font-size: 8.5pt; color: root.c_text_dim; }
                                AppInput { text <=> root.cfg_app_token; input-type: InputType.password; }

                                Text { text: "Twitch Client Secret:"; font-size: 8.5pt; color: root.c_text_dim; }
                                AppInput { text <=> root.cfg_client_secret; input-type: InputType.password; }

                                Text { text: "Twitch Refresh Token:"; font-size: 8.5pt; color: root.c_text_dim; }
                                AppInput { text <=> root.cfg_refresh_token; input-type: InputType.password; }

                                HorizontalLayout {
                                    spacing: 8px;
                                    AppButton { text: "Обновить токен"; clicked => { root.refresh_token_manually(); } }
                                    Text { text: root.cfg_token_status; color: root.c_text_dim; font-size: 8.5pt; vertical-alignment: center; }
                                    Rectangle { }
                                }
                            }
                        }

                        // Section 3: Paths & Network
                        Rectangle {
                            background: #171924;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #252838;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;

                                Text { text: "КАТАЛОГИ И СЕТЬ"; font-size: 8pt; font-weight: 800; color: #767a8c; }

                                Text { text: "Папка records:"; font-size: 8.5pt; color: root.c_text_dim; }
                                AppInput { text <=> root.cfg_records_dir; }

                                Text { text: "SERVER_URL (сервер мониторинга):"; font-size: 8.5pt; color: root.c_text_dim; }
                                AppInput { text <=> root.cfg_server_url; placeholder-text: "https://your-bot-server.com"; }

                                Text { text: "Twitch Proxy Playlist (--twitch-proxy-playlist):"; font-size: 8.5pt; color: root.c_text_dim; }
                                AppInput { text <=> root.cfg_proxy_playlist; placeholder-text: "прокси через запятую"; }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "Движок чата: Rust (twitch_chat.dll)"; color: #a3be8c; font-weight: 700; font-size: 8.5pt; vertical-alignment: center; }
                                    Rectangle { }
                                }
                            }
                        }

                        // Save action
                        HorizontalLayout {
                            Rectangle { }
                            AppButton {
                                text: "💾 Сохранить настройки";
                                primary: true;
                                custom_height: 38px;
                                clicked => { root.save_settings(); }
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal Close Confirmation Dialog
    if root.show_close_dialog: Rectangle {
        background: #000000b0;

        TouchArea {
            clicked => { root.cancel_close(); }
        }

        Rectangle {
            width: 280px;
            height: 192px;
            background: #1f1f23;
            border-radius: 8px;
            border-width: 1px;
            border-color: #3b3b44;

            TouchArea { }

            card_layout := VerticalLayout {
                padding-top: 14px;
                padding-bottom: 14px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 6px;

                Text {
                    text: "Закрытие лаунчера";
                    font-size: 11pt;
                    font-weight: 700;
                    color: #ffffff;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Что сделать с приложением?";
                    font-size: 9pt;
                    color: root.c_text_dim;
                    horizontal-alignment: center;
                }

                Rectangle { height: 2px; }

                DialogButton {
                    text: "Выйти";
                    bg_color: #9F2305;
                    hover_color: #ba2a07;
                    clicked => { root.confirm_quit(); }
                }

                DialogButton {
                    text: "Свернуть в трей";
                    bg_color: #9146ff;
                    hover_color: #772ce8;
                    clicked => { root.confirm_minimize_to_tray(); }
                }

                DialogButton {
                    text: "Отмена";
                    bg_color: #2d2d35;
                    hover_color: #3b3b44;
                    clicked => { root.cancel_close(); }
                }
            }
        }
    }
}

export component LauncherTray inherits SystemTrayIcon {
    in-out property <string> tray_tooltip: "Twitch recorder";
    in-out property <string> status_text: "Готов к работе";

    icon: @image-url("assets/app.png");
    tooltip: root.tray_tooltip;

    clicked => {
        root.toggle_window();
    }

    Menu {
        MenuItem {
            title: "Показать / Скрыть окно";
            activated => { root.toggle_window(); }
        }
        MenuItem {
            title: root.status_text;
            enabled: false;
        }
        MenuItem {
            title: "Выход";
            activated => { root.quit_app(); }
        }
    }

    callback toggle_window();
    callback quit_app();
}
